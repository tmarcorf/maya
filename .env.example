# Polaris — voice agent (Pipecat + Hermes Agent)
# Copy to .env and fill in the values. Never commit .env.

# --- Hermes Agent ---
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent
# App-level conversation id (voice-session-<uuid> is generated when empty)
HERMES_SESSION_ID=

# --- STT (Whisper / faster-whisper, local) ---
STT_MODEL=small            # tiny, base, small, medium, large
STT_DEVICE=cpu             # cpu, cuda or auto
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=pt            # empty = auto-detect the spoken language

# --- TTS (Kokoro local; ou ElevenLabs na nuvem) ---
TTS_PROVIDER=kokoro        # kokoro (local) ou elevenlabs (requer internet + chave)
TTS_LANGUAGE=pt
TTS_VOICE=pf_dora          # vozes pt-BR kokoro: pf_dora, pm_alex, pm_santa

# --- ElevenLabs (alternativo: TTS_PROVIDER=elevenlabs) ---
# Chave e voz são obrigatórias nesse modo; o modelo tem default sensato p/ tempo real.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=       # id da voz (premade, ex.: 21m00Tcm4TlvDq8ikWAM, ou clonada)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5   # baixa latência, multilingual (inclui pt-BR)

# --- Wake word (por transcrição, usa o STT local) ---
WAKE_WORD_ENABLED=false              # true/false
WAKE_WORD_PHRASES=E aí, Polaris;Ei, Polaris;Polaris, tá aí?   # lista separada por ';'
WAKE_WORD_TIMEOUT=10                 # segundos de inatividade até voltar a dormir

# --- Application ---
LOG_LEVEL=INFO

# --- Audio (PyAudio device indices; empty = system default) ---
# AUDIO_IN_DEVICE=
# AUDIO_OUT_DEVICE=
