# Polaris — voice agent (Pipecat + Hermes Agent)
# Copy to .env and fill in the values. Never commit .env.

# --- Hermes Agent ---
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent
# App-level conversation id (voice-session-<uuid> is generated when empty)
HERMES_SESSION_ID=

# --- STT (Whisper / faster-whisper, local) ---
STT_MODEL=small            # tiny, base, small, medium, large
STT_DEVICE=cpu             # cpu, cuda or auto
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=pt            # empty = auto-detect the spoken language

# --- TTS (Kokoro local; Qwen3-TTS local GPU; ou ElevenLabs na nuvem) ---
TTS_PROVIDER=kokoro        # kokoro (local), qwen3 (local, GPU NVIDIA) ou elevenlabs (internet + chave)
TTS_LANGUAGE=pt
TTS_VOICE=pf_dora          # vozes pt-BR kokoro: pf_dora, pm_alex, pm_santa

# --- ElevenLabs (alternativo: TTS_PROVIDER=elevenlabs) ---
# Chave e voz são obrigatórias nesse modo; o modelo tem default sensato p/ tempo real.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=       # id da voz (premade, ex.: 21m00Tcm4TlvDq8ikWAM, ou clonada)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5   # baixa latência, multilingual (inclui pt-BR)

# --- Qwen3-TTS (alternativo: TTS_PROVIDER=qwen3; local, requer GPU NVIDIA CUDA) ---
# Primeira execução baixa ~1,5-2 GB do Hugging Face Hub (~/.cache/huggingface).
QWEN3_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice   # CustomVoice (9 vozes prontas) ou ...-0.6B-Base (clonagem)
QWEN3_DEVICE=cuda             # cuda, cuda:0, cpu (fallback lento) ou auto
QWEN3_DTYPE=bfloat16          # float16, bfloat16 ou float32
QWEN3_SPEAKER=Ryan            # vozes: Vivian, Serena, Uncle_Fu, Dylan, Eric, Ryan, Aiden, Ono_Anna, Sohee
# Estilo opcional (ex.: "Fale devagar e com calma."). Vazio = sem instrução.
QWEN3_INSTRUCT=
# Clonagem de voz (obrigatório quando QWEN3_MODEL termina em -Base):
# QWEN3_REF_AUDIO=/caminho/para/ref.wav   # ~3s de áudio de referência (arquivo local ou URL)
# QWEN3_REF_TEXT=                          # transcrição do áudio; vazio = só o timbre
# QWEN3_ATTN_IMPLEMENTATION=               # vazio = sdpa; ou flash_attention_2 (requer flash-attn)
# QWEN3_MAX_NEW_TOKENS=4096
# QWEN3_TOP_P=                             # vazio = default do modelo

# --- Wake word (por transcrição, usa o STT local) ---
WAKE_WORD_ENABLED=true              # true/false
WAKE_WORD_PHRASES=E aí, Polaris;Ei, Polaris;Polaris, tá aí?   # lista separada por ';'
WAKE_WORD_TIMEOUT=10                 # segundos de inatividade até voltar a dormir

# --- VAD (Silero) — latência de fim de turno ---
# stop_secs = silêncio que confirma que você terminou de falar. Menor =
# resposta mais rápida, mas pausas longas podem cortar sua fala.
# Default Pipecat é 0.2s; Polaris usa 0.12s.
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.12
VAD_MIN_VOLUME=0.6

# --- Application ---
LOG_LEVEL=INFO

# --- Audio (PyAudio device indices; empty = system default) ---
# AUDIO_IN_DEVICE=
# AUDIO_OUT_DEVICE=
