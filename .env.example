# LiveKit server (required for dev/start, ignored by console mode)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Conversation language: pt-BR (default) or en-US
MAYA_LANGUAGE=pt-BR
MAYA_PROMPT_PATH=prompts/maya.md
MAYA_TIMEZONE=America/Sao_Paulo

# Local speech-to-text (faster-whisper)
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Hermes API server: owns the LLM, tools, memory and skills.
# Create the profile first; see README.md.
HERMES_BASE_URL=http://127.0.0.1:8642/p/maya-voice/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_SESSION_KEY=maya-user
HERMES_MAX_RETRIES=1
HERMES_TIMEOUT_SECONDS=180

# Fallback approval page for runs started by the voice layer.
HERMES_APPROVAL_ENABLED=true
HERMES_APPROVAL_PORT=8765

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Turn taking
# v1-mini runs locally on CPU; v1 uses LiveKit Inference (requires LiveKit Cloud credentials)
TURN_DETECTOR_VERSION=v1-mini
ENDPOINTING_MODE=fixed
MIN_ENDPOINTING_DELAY=0.3
MAX_ENDPOINTING_DELAY=2.5
MIN_INTERRUPTION_DURATION=0.4
