{
  "name": "polaris-desktop",
  "productName": "Polaris",
  "version": "0.1.0",
  "private": true,
  "description": "Companion desktop do agente de voz Polaris (orb 3D + chat + wake word)",
  "author": "tmarcorf",
  "homepage": "https://github.com/tmarcorf/polaris",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "mock": "node scripts/mock-bridge.mjs",
    "test": "vitest run",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dev": "npm run build:electron && concurrently -k \"vite --port 5174\" \"wait-on http://127.0.0.1:5174 && VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  }
}
